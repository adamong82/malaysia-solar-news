# ---- Telegram 推送（必填才能收到消息）----
# 1) 找 @BotFather /newbot 创建 bot，拿到 token
# 2) 给你的 bot 发一条消息，然后打开
#    https://api.telegram.org/bot<TOKEN>/getUpdates 取 chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 公网访问鉴权（部署到公网必设！）----
# 设置后，看板和 API 必须带密钥：浏览器访问 /?key=<值> 一次即可（自动种 cookie）
# 外部程序调 API 带 header: X-Access-Token: <值>
WEB_ACCESS_TOKEN=

# ---- Webhook 接入鉴权（可选但建议设置）----
# 设置后，POST /webhook 必须带 header: X-Webhook-Token: <值>
# （限流：每 IP 每小时 60 次）
WEBHOOK_TOKEN=

# ---- 调度 ----
ENABLE_SCHEDULER=1
RUN_ON_START=0
COLLECT_INTERVAL_MIN=60

# ---- 其他 ----
# DATA_DIR=./data
# HTTP_TIMEOUT=25
